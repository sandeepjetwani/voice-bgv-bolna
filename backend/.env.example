# Copy to .env and fill in if connecting to real Bolna.
# Without these set, the backend runs in mock mode (no outbound calls).

PORT=3001

# Bolna integration — leave blank for mock mode
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_API_HOST=https://api.bolna.dev
BOLNA_API_URL=https://api.bolna.dev/v1/call

# Where Bolna posts webhook events. Used by create-agent.js.
# Locally: use ngrok URL (https://abc123.ngrok.io/webhook/bolna)
# Deployed: https://your-backend.onrender.com/webhook/bolna
BACKEND_WEBHOOK_URL=

# BGV company name used in the agent's opening line
BGV_COMPANY_NAME="Equal Identity"
